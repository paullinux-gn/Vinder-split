<?xml version="1.0" encoding="UTF-8"?>
<!--
  FROZEN SNAPSHOT - do not edit and do not add new keys.

  Describes the settings that Vinder 1.6 and older stored at /org/gnome/nautilus/,
  the same place GNOME Files uses. They are relocatable schemas so that
  src/vinder-settings-migration.c can read the old values once and copy them into
  Vinder's own location (/io/github/paullinux_gn/Vinder/).
-->
<schemalist>
  <enum id="io.github.paullinux_gn.Vinder.Legacy.SpeedTradeoff">
    <value value="0" nick="always" />
    <value value="1" nick="local-only" />
    <value value="2" nick="never" />
  </enum>
  <enum id="io.github.paullinux_gn.Vinder.Legacy.ClickPolicy">
    <value value="0" nick="single" />
    <value value="1" nick="double" />
  </enum>
  <enum id="io.github.paullinux_gn.Vinder.Legacy.DateTimeFormat">
    <value value="0" nick="simple" />
    <value value="1" nick="detailed" />
  </enum>
  <enum id="io.github.paullinux_gn.Vinder.Legacy.ActivationChoice">
    <value value="0" nick="launch" />
    <value value="1" nick="display" />
    <value value="2" nick="ask" />
  </enum>
  <enum id="io.github.paullinux_gn.Vinder.Legacy.FolderView">
    <value value="1" nick="list-view" />
    <value value="2" nick="icon-view" />
  </enum>
  <enum id="io.github.paullinux_gn.Vinder.Legacy.SortOrder">
    <value value="0" nick="name" />
    <value value="1" nick="size" />
    <value value="2" nick="type" />
    <value value="3" nick="date_modified" />
    <value value="4" nick="date_accessed" />
    <value value="5" nick="date_created" />
    <value value="6" nick="starred" />
  </enum>
  <enum id="io.github.paullinux_gn.Vinder.Legacy.GridZoomLevel">
    <value value="0" nick="small" />
    <value value="1" nick="small-plus" />
    <value value="2" nick="medium" />
    <value value="3" nick="large" />
    <value value="4" nick="extra-large" />
  </enum>
  <enum id="io.github.paullinux_gn.Vinder.Legacy.ListZoomLevel">
    <value value="0" nick="small" />
    <value value="1" nick="medium" />
    <value value="2" nick="large" />
  </enum>
  <enum id="io.github.paullinux_gn.Vinder.Legacy.SearchFilterTimeType">
    <value value="0" nick="last_modified" />
    <value value="1" nick="last_used" />
    <value value="2" nick="created" />
  </enum>
  <enum id="io.github.paullinux_gn.Vinder.Legacy.CompressionFormat">
    <value value="0" nick="zip" />
    <value value="1" nick="tar.xz" />
    <value value="2" nick="7z" />
    <value value="3" nick="encrypted_zip" />
  </enum>
  <schema id="io.github.paullinux_gn.Vinder.Legacy.preferences" gettext-domain="nautilus">
    <key name="vinder-blur" type="b">
      <default>false</default>
    </key>
    <key name="vinder-menu-blur" type="b">
      <default>true</default>
    </key>
    <key name="vinder-scroll-animation" type="b">
      <default>false</default>
    </key>
    <key name="vinder-zebra-rows" type="b">
      <default>false</default>
    </key>
    <key name="vinder-pop-icons" type="b">
      <default>false</default>
    </key>
    <key name="vinder-icon-shadow-strength" type="d">
      <range min="0" max="100" />
      <default>100</default>
    </key>
    <key name="vinder-blur-reminder-seen" type="b">
      <default>false</default>
    </key>
    <key name="vinder-blur-opacity" type="d">
      <range min="0" max="100" />
      <default>78</default>
    </key>
    <key name="vinder-blur-strength" type="d">
      <range min="0" max="40" />
      <default>30</default>
    </key>
    <key name="vinder-appearance" type="s">
      <choices>
        <choice value="light" />
        <choice value="dark" />
        <choice value="dark-and-light" />
      </choices>
      <default>'light'</default>
    </key>
    <key type="b" name="always-use-location-entry">
      <default>false</default>
    </key>
    <key name="recursive-search" enum="io.github.paullinux_gn.Vinder.Legacy.SpeedTradeoff">
      <default>'local-only'</default>
    </key>
    <key name="search-filter-time-type" enum="io.github.paullinux_gn.Vinder.Legacy.SearchFilterTimeType">
      <default>'last_modified'</default>
    </key>
    <key type="b" name="show-delete-permanently">
      <default>false</default>
    </key>
    <key type="b" name="show-create-link">
      <default>false</default>
    </key>
    <key name="show-directory-item-counts" enum="io.github.paullinux_gn.Vinder.Legacy.SpeedTradeoff">
      <aliases>
        <alias value="local_only" target="local-only" />
      </aliases>
      <default>'local-only'</default>
    </key>
    <key name="click-policy" enum="io.github.paullinux_gn.Vinder.Legacy.ClickPolicy">
      <default>'double'</default>
    </key>
    <key type="b" name="mouse-use-extra-buttons">
      <default>true</default>
    </key>
    <key type="u" name="mouse-forward-button">
      <default>9</default>
    </key>
    <key type="u" name="mouse-back-button">
      <default>8</default>
    </key>
    <key name="show-image-thumbnails" enum="io.github.paullinux_gn.Vinder.Legacy.SpeedTradeoff">
      <aliases>
        <alias value="local_only" target="local-only" />
      </aliases>
      <default>'local-only'</default>
    </key>
    <key type="t" name="thumbnail-limit">
      <default>50</default>
    </key>
    <key name="default-sort-order" enum="io.github.paullinux_gn.Vinder.Legacy.SortOrder">
      <aliases>
        <alias value="atime" target="date_accessed" />
        <alias value="btime" target="date_created" />
        <alias value="mtime" target="date_modified" />
      </aliases>
      <default>'name'</default>
    </key>
    <key type="b" name="default-sort-in-reverse-order">
      <default>false</default>
    </key>
    <key name="default-folder-viewer" enum="io.github.paullinux_gn.Vinder.Legacy.FolderView">
      <aliases>
        <alias value="compact-view" target="icon-view" />
      </aliases>
      <default>'icon-view'</default>
    </key>
    <key type="b" name="open-folder-on-dnd-hover">
      <default>true</default>
    </key>
    <key type="b" name="fts-enabled">
      <default>true</default>
    </key>
    <key name="date-time-format" enum="io.github.paullinux_gn.Vinder.Legacy.DateTimeFormat">
      <default>'simple'</default>
    </key>
  </schema>
  <schema id="io.github.paullinux_gn.Vinder.Legacy.compression" gettext-domain="nautilus">
    <key name="default-compression-format" enum="io.github.paullinux_gn.Vinder.Legacy.CompressionFormat">
      <default>'zip'</default>
    </key>
  </schema>
  <schema id="io.github.paullinux_gn.Vinder.Legacy.icon-view" gettext-domain="nautilus">
    <key type="as" name="captions">
      <default>[ 'none', 'none', 'none' ]</default>
    </key>
    <key name="default-zoom-level" enum="io.github.paullinux_gn.Vinder.Legacy.GridZoomLevel">
      <aliases>
        <alias value="standard" target="small-plus" />
        <alias value="larger" target="extra-large" />
        <alias value="largest" target="extra-large" />
      </aliases>
      <default>'medium'</default>
    </key>
  </schema>
  <schema id="io.github.paullinux_gn.Vinder.Legacy.list-view" gettext-domain="nautilus">
    <key name="default-zoom-level" enum="io.github.paullinux_gn.Vinder.Legacy.ListZoomLevel">
      <aliases>
        <alias value="standard" target="medium" />
        <alias value="larger" target="large" />
      </aliases>
      <default>'medium'</default>
    </key>
    <key type="as" name="default-visible-columns">
      <default>[ 'name', 'size', 'date_modified' ]</default>
    </key>
    <key type="as" name="default-column-order">
      <default>[ 'name', 'size', 'type', 'owner', 'group', 'permissions', 'mime_type', 'where', 'date_modified', 'date_modified_with_time', 'date_accessed', 'date_created', 'recency', 'starred' ]</default>
    </key>
    <key type="b" name="use-tree-view">
      <default>false</default>
    </key>
  </schema>
  <schema id="io.github.paullinux_gn.Vinder.Legacy.window-state" gettext-domain="nautilus">
    <key type="(ii)" name="initial-size">
      <default>(890, 550)</default>
    </key>
    <key type="b" name="maximized">
      <default>false</default>
    </key>
    <key type="(ii)" name="initial-size-file-chooser">
      <default>(890,550)</default>
    </key>
  </schema>
</schemalist>
